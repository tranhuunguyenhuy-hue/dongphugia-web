{
  "contract": "dpg-production-backup-scope",
  "current_version": 2,
  "versions": {
    "1": {
      "schemas": [
        "dpg_app",
        "dpg_control"
      ],
      "coverage": "limited",
      "note": "historical M4/M5 bundles before DPG-42; dpg_commerce is NOT covered"
    },
    "2": {
      "schemas": [
        "dpg_app",
        "dpg_control",
        "dpg_commerce"
      ],
      "coverage": "full",
      "note": "DPG-42: adds dpg_commerce (orders, quotes, events)",
      "runtime_roles": {
        "dpg_order_intake_login": {
          "login": true,
          "role_inherit": false,
          "member_of": {
            "dpg_commerce_intake": {
              "admin": false,
              "inherit": false,
              "set": true
            }
          },
          "note": "order-intake login provisioned by scripts/m6/production-sql-apply.mjs provisionIntake: NOINHERIT login, member of dpg_commerce_intake (SET ROLE only); password is never backed up"
        }
      },
      "platform_roles": [
        "postgres"
      ],
      "platform_edge_shapes": [
        {
          "grantor": "supabase_admin",
          "admin": true,
          "inherit": false,
          "set": false,
          "note": "implicit creator grant recorded by the bootstrap superuser when postgres creates a role"
        },
        {
          "grantor": "postgres",
          "admin": false,
          "inherit": true,
          "set": true,
          "note": "repo migrations: grant <role> to postgres"
        },
        {
          "grantor": "postgres",
          "admin": false,
          "inherit": false,
          "set": false,
          "note": "legacy direct-access roles"
        }
      ],
      "role_settings": {
        "application_name": "^(dpg-migration|dpg-runtime|dpg-readonly)$",
        "default_transaction_read_only": "^(on|off|true|false)$",
        "idle_in_transaction_session_timeout": "^[0-9]{1,9}(ms|s|min|h|d)?$",
        "lock_timeout": "^[0-9]{1,9}(ms|s|min|h|d)?$",
        "row_security": "^(on|off|true|false)$",
        "search_path": "^(\"[$]user\"|pg_catalog|dpg_app|dpg_control|dpg_commerce|public|auth|extensions|pg_temp)(, ?(\"[$]user\"|pg_catalog|dpg_app|dpg_control|dpg_commerce|public|auth|extensions|pg_temp)){0,8}$",
        "statement_timeout": "^[0-9]{1,9}(ms|s|min|h|d)?$"
      },
      "role_settings_note": "Only these setting names with values matching the pattern are exported to the plaintext roles.txt; anything else fails the backup (name only is reported, never the value). search_path accepts only the reviewed schema tokens (pg_catalog, dpg_app, dpg_control, dpg_commerce, public, auth, extensions, pg_temp and the literal quoted $user); row_security is boolean. Adding a setting or a token needs a reviewed change here."
    }
  },
  "excluded": {},
  "discovery": {
    "schema_pattern": "dpg\\_%",
    "relkinds": [
      "r",
      "p"
    ]
  }
}
