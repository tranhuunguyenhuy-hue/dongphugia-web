{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dongphugia-v1-public-production",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/uudaicuoinam2026",
      "/uudaicuoinam2026/*"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "APP_BUILD_TARGET": "public",
    "APP_ORIGIN": "https://www.dongphugia.vn",
    "PUBLIC_CATALOGUE_SOURCE": "postgresql"
  },
  "hyperdrive": [
    {
      "binding": "PUBLIC_DB",
      "id": "905f5791e9d84cf285f7533b92d03f49"
    }
  ]
}
